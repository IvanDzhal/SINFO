# Скопіюйте у .env.production НА СЕРВЕРІ і заповніть.
# POSTGRES_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY — ТІЛЬКИ hex (openssl rand -hex 32): спецсимволи (/ + = @) ламають DATABASE_URL.
# JWT_* і LINK_SIGNING_SECRET: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LINK_SIGNING_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Звідки браузер звертається до сайту (без слеша в кінці). Поки без домену: http://<IP сервера>:8081
CORS_ORIGINS=http://203.0.113.10:8081

# Порти reverse proxy. Поки стара версія живе на 80/443 — тримайте 8081/8443.
HTTP_PORT=8081
HTTPS_PORT=8443
# ":80" = HTTP без домену. Після переїзду: sinfo.example.com (HTTPS автоматично)
SITE_ADDRESS=:80

# ФІКСОВАНИЙ пароль admin (мін. 12 символів). Seed задає/скидає його при кожному запуску. Якщо порожньо — генерується випадковий
SEED_ADMIN_PASSWORD=

# Telegram-сповіщення про бекап (бот пише у чат/групу, chat id — через @userinfobot або getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Бекапи у Google Drive (rclone remote:папка). Порожньо = лише локально.
RCLONE_REMOTE=gdrive:sluhavkainfo-backups
BACKUP_KEEP_DAYS=14
# Додаткові шляхи у системний бекап через пробіл (напр. конфіги старих проєктів)
EXTRA_PATHS=
