{
	# HTTPS та сертифікати — справа окремого gateway (/opt/gateway)
	auto_https off
	# gateway стоїть перед нами — довіряємо його X-Forwarded-For
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
