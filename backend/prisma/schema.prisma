generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
}

enum Scope {
  GLOBAL
  REGION
  STORE
  SELF
}

model User {
  id                  String     @id @default(uuid())
  login               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus @default(active)
  position            String?
  employmentStartDate DateTime?
  regionId            String?
  cityId              String?
  storeId             String?
  region              Region?    @relation(fields: [regionId], references: [id])
  city                City?      @relation(fields: [cityId], references: [id])
  store               Store?     @relation(fields: [storeId], references: [id])
  roles               UserRole[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastLoginAt         DateTime?
  managedRegions      UserRegion[]
  auditLogs           AuditLog[]
  presence       UserPresence?
  knowledgeItems KnowledgeItem[]
  knowledgeReads KnowledgeRead[]
  knowledgeVersions KnowledgeVersion[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isSystem    Boolean          @default(false)
  archivedAt  DateTime?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // напр. "knowledge.view"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  scope        Scope
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId, scope])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Region {
  id     String  @id @default(uuid())
  name   String @unique
  status String  @default("active")
  cities City[]
  stores Store[]
  users  User[]
  managers UserRegion[]
}

model City {
  id       String  @id @default(uuid())
  name     String
  regionId String
  region   Region  @relation(fields: [regionId], references: [id])
  stores   Store[]
  users    User[]
  status String @default("active")
}

model BrandFormat {
  id     String  @id @default(uuid())
  name   String  @unique
  status String  @default("active")
  stores Store[]
}

model Store {
  id            String      @id @default(uuid())
  name          String
  regionId      String
  cityId        String
  address       String?
  status        String      @default("active")
  brandFormatId String
  region        Region      @relation(fields: [regionId], references: [id])
  city          City        @relation(fields: [cityId], references: [id])
  brandFormat   BrandFormat @relation(fields: [brandFormatId], references: [id])
  users         User[]
}

model UserRegion {
  id       String @id @default(uuid())
  userId   String
  regionId String
  user     User   @relation(fields: [userId], references: [id])
  region   Region @relation(fields: [regionId], references: [id])

  @@unique([userId, regionId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model UserPresence {
  userId         String   @id
  lastActivityAt DateTime
  user           User     @relation(fields: [userId], references: [id])
}

model KnowledgeCategory {
  id         String              @id @default(uuid())
  name       String
  icon       String?
  parentId   String?
  parent     KnowledgeCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   KnowledgeCategory[] @relation("CategoryTree")
  sortOrder  Int                 @default(0)
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  items KnowledgeItem[]
}

enum KnowledgeType {
  instruction
  material
  news
}

enum KnowledgeStatus {
  draft
  published
  archived
}

enum VisibilityKind {
  GLOBAL
  REGION
  STORE
  ROLE
}

model KnowledgeItem {
  id                 String              @id @default(uuid())
  type               KnowledgeType
  title              String
  description        String              @default("")
  content            Json?
  contentText        String              @default("")
  categoryId         String?
  category           KnowledgeCategory?  @relation(fields: [categoryId], references: [id])
  authorId           String
  author             User                @relation(fields: [authorId], references: [id])
  status             KnowledgeStatus     @default(draft)
  version            Int                 @default(1)
  isRequired         Boolean             @default(false)
  readingTimeMinutes Int                 @default(1)
  viewsCount         Int                 @default(0)
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  visibility         KnowledgeVisibility[]
  reads              KnowledgeRead[]
  versions KnowledgeVersion[]

  @@index([type, status])
}

model KnowledgeVisibility {
  id       String         @id @default(uuid())
  itemId   String
  kind     VisibilityKind
  targetId String?
  item     KnowledgeItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model KnowledgeRead {
  id       String        @id @default(uuid())
  userId   String
  itemId   String
  readAt   DateTime      @default(now())
  storeId  String?
  regionId String?
  user     User          @relation(fields: [userId], references: [id])
  item     KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model KnowledgeVersion {
  id          String        @id @default(uuid())
  itemId      String
  version     Int
  title       String
  description String        @default("")
  content     Json?
  authorId    String
  createdAt   DateTime      @default(now())
  item        KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id])

  @@unique([itemId, version])
}