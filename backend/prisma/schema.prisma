generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
}

enum Scope {
  GLOBAL
  REGION
  STORE
  SELF
}

model User {
  id                  String     @id @default(uuid())
  login               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus @default(active)
  position            String?
  regionId            String?
  cityId              String?
  storeId             String?
  region              Region?    @relation(fields: [regionId], references: [id])
  city                City?      @relation(fields: [cityId], references: [id])
  store               Store?     @relation(fields: [storeId], references: [id])
  roles               UserRole[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastLoginAt         DateTime?
  avatarKey           String?
  avatarMime          String?
  avatarUpdatedAt     DateTime?
  activityDays        UserActivityDay[]
  managedRegions      UserRegion[]
  auditLogs           AuditLog[]
  presence       UserPresence?
  knowledgeItems KnowledgeItem[]
  knowledgeReads KnowledgeRead[]
  knowledgeVersions KnowledgeVersion[]
  knowledgeFiles KnowledgeFile[]
  notifications Notification[]
  createdTests Test[]
  testAttempts TestAttempt[]
  trainingDone TrainingLessonDone[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  isSystem    Boolean          @default(false)
  archivedAt  DateTime?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // напр. "knowledge.view"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  scope        Scope
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId, scope])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Region {
  id     String  @id @default(uuid())
  name   String @unique
  status String  @default("active")
  cities City[]
  stores Store[]
  users  User[]
  managers UserRegion[]
}

model City {
  id       String  @id @default(uuid())
  name     String
  regionId String
  region   Region  @relation(fields: [regionId], references: [id])
  stores   Store[]
  users    User[]
  status String @default("active")
}

model BrandFormat {
  id     String  @id @default(uuid())
  name   String  @unique
  status String  @default("active")
  stores Store[]
}

model Store {
  id            String      @id @default(uuid())
  name          String
  regionId      String
  cityId        String
  address       String?
  status        String      @default("active")
  brandFormatId String
  region        Region      @relation(fields: [regionId], references: [id])
  city          City        @relation(fields: [cityId], references: [id])
  brandFormat   BrandFormat @relation(fields: [brandFormatId], references: [id])
  users         User[]
  // Короткий код магазину (ЗАБ, СТЛ…): його використовують працівники й імпорт
  code          String?     @unique
  dataSource    DataSource?
  salesSnapshots SalesSnapshot[]
  salesMetrics  SalesMetric[]
}

model UserRegion {
  id       String @id @default(uuid())
  userId   String
  regionId String
  user     User   @relation(fields: [userId], references: [id])
  region   Region @relation(fields: [regionId], references: [id])

  @@unique([userId, regionId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model UserPresence {
  userId         String   @id
  lastActivityAt DateTime
  user           User     @relation(fields: [userId], references: [id])
}

// День, коли користувач відкривав портал (для KPI «Днів активності»)
model UserActivityDay {
  userId String
  day    DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model KnowledgeCategory {
  id         String              @id @default(uuid())
  name       String
  icon       String?
  parentId   String?
  parent     KnowledgeCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   KnowledgeCategory[] @relation("CategoryTree")
  sortOrder  Int                 @default(0)
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  items KnowledgeItem[]
  tests Test[]
}

enum KnowledgeType {
  instruction
  material
  news
}

enum KnowledgeStatus {
  draft
  published
  archived
}

enum VisibilityKind {
  GLOBAL
  REGION
  STORE
  ROLE
  BRAND
}

model KnowledgeItem {
  id                 String              @id @default(uuid())
  type               KnowledgeType
  title              String
  description        String              @default("")
  content            Json?
  contentText        String              @default("")
  categoryId         String?
  category           KnowledgeCategory?  @relation(fields: [categoryId], references: [id])
  authorId           String
  author             User                @relation(fields: [authorId], references: [id])
  status             KnowledgeStatus     @default(draft)
  version            Int                 @default(1)
  isRequired         Boolean             @default(false)
  readingTimeMinutes Int                 @default(1)
  viewsCount         Int                 @default(0)
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  visibility         KnowledgeVisibility[]
  reads              KnowledgeRead[]
  versions KnowledgeVersion[]
  files KnowledgeFile[]
  slug               String?             @unique
  tests Test[]

  @@index([type, status])
}

model KnowledgeVisibility {
  id       String         @id @default(uuid())
  itemId   String
  kind     VisibilityKind
  targetId String?
  item     KnowledgeItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model KnowledgeRead {
  id       String        @id @default(uuid())
  userId   String
  itemId   String
  readAt   DateTime      @default(now())
  storeId  String?
  regionId String?
  user     User          @relation(fields: [userId], references: [id])
  item     KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model KnowledgeVersion {
  id          String        @id @default(uuid())
  itemId      String
  version     Int
  title       String
  description String        @default("")
  content     Json?
  authorId    String
  createdAt   DateTime      @default(now())
  item        KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id])

  @@unique([itemId, version])
}

model KnowledgeFile {
  id           String         @id @default(uuid())
  key          String         @unique
  originalName String
  mimeType     String
  size         Int
  kind         String
  itemId       String?
  item         KnowledgeItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())
  trainingLessons TrainingLesson[]

  @@index([itemId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  kind      String
  title     String
  body      String    @default("")
  link      String
  itemId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, kind])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum TestStatus {
  draft
  published
  archived
}

enum QuestionType {
  single
  multiple
  matching
  input
}

enum Difficulty {
  easy
  medium
  hard
}

model Test {
  id                  String             @id @default(uuid())
  title               String
  description         String             @default("")
  categoryId          String?
  category            KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  linkedItemId        String?
  linkedItem          KnowledgeItem?     @relation(fields: [linkedItemId], references: [id], onDelete: SetNull)
  status              TestStatus         @default(draft)
  isRequired          Boolean            @default(false)
  deadline            DateTime?
  questionCount       Int                @default(20)
  timeLimitMinutes    Int                @default(25)
  passingScorePercent Int                @default(80)
  maxAttempts         Int                @default(2)
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  publishedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  questions           TestQuestion[]
  visibility          TestVisibility[]
  attempts TestAttempt[]
  trainingStages TrainingStage[]

  @@index([status])
}

model TestVisibility {
  id       String         @id @default(uuid())
  testId   String
  kind     VisibilityKind
  targetId String?
  test     Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestQuestion {
  id          String       @id @default(uuid())
  testId      String
  type        QuestionType
  text        String
  explanation String       @default("")
  difficulty  Difficulty   @default(medium)
  points      Int          @default(2)
  position    Int          @default(0)
  accepted    Json?
  archivedAt  DateTime?
  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  options     TestOption[]
  answers TestAnswer[]

  @@index([testId])
}

model TestOption {
  id         String       @id @default(uuid())
  questionId String
  label      String
  matchLabel String?
  isCorrect  Boolean      @default(false)
  position   Int          @default(0)
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

enum AttemptStatus {
  in_progress
  completed
}

model TestAttempt {
  id            String        @id @default(uuid())
  testId        String
  userId        String
  attemptNumber Int
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  completedAt   DateTime?
  timedOut      Boolean       @default(false)
  status        AttemptStatus @default(in_progress)
  questionIds   String[]
  seed          Int
  score         Int?
  maxScore      Int
  scorePercent  Float?
  passed        Boolean?
  test          Test          @relation(fields: [testId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  answers       TestAnswer[]

  @@unique([testId, userId, attemptNumber])
  @@index([userId, testId])
  @@index([testId, status])
}

model TestAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  questionId String
  answer     Json?
  isCorrect  Boolean?
  score      Int?
  answeredAt DateTime     @default(now())
  attempt    TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   TestQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ───────── Data Sync / Sales (DATA_SYNC_v1.1, ANALYTICS_v1 §5–14) ─────────

enum SyncStatus {
  pending
  running
  success
  partial
  failed
}

// Джерело даних магазину (v1: одна таблиця на магазин)
model DataSource {
  id                   String        @id @default(uuid())
  storeId              String        @unique
  provider             String        @default("google_sheets")
  externalId           String
  sheetName            String?
  status               String        @default("active")
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  store                Store         @relation(fields: [storeId], references: [id])
  mappings             DataMapping[]
  runs                 SyncRun[]
  snapshots            SalesSnapshot[]
  metrics              SalesMetric[]
}

// Звідки брати показник. key: plan.TO | fact.TO | day.TO | meta.days_passed | meta.days_left
// cells — A1-посилання; кілька комірок підсумовуються.
model DataMapping {
  id        String     @id @default(uuid())
  sourceId  String
  key       String
  cells     String[]
  source    DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, key])
}

// Конфігуровані метрики (базові й ефективність). thresholds — кольорова градація.
model SalesMetricDef {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String
  shortName      String
  kind           String        @default("base")
  unit           String        @default("currency")
  numerator      String?
  denominator    String?
  thresholds     Json?
  active         Boolean       @default(true)
  displayOrder   Int           @default(0)
  metrics        SalesMetric[]
}

model SyncRun {
  id             String     @id @default(uuid())
  sourceId       String
  trigger        String     @default("auto")
  status         SyncStatus @default(pending)
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  recordsRead    Int        @default(0)
  recordsSaved   Int        @default(0)
  recordsUpdated Int        @default(0)
  errorsCount    Int        @default(0)
  errorMessage   String?
  details        Json?
  triggeredById  String?
  source         DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshots      SalesSnapshot[]
  metrics        SalesMetric[]

  @@index([sourceId, startedAt])
}

// Зріз таблиці магазину на дату: службові поля й raw-значення для діагностики
model SalesSnapshot {
  id         String      @id @default(uuid())
  storeId    String
  date       DateTime    @db.Date
  daysPassed Int?
  daysLeft   Int?
  raw        Json
  sourceId   String?
  syncId     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  store      Store       @relation(fields: [storeId], references: [id])
  source     DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sync       SyncRun?    @relation(fields: [syncId], references: [id], onDelete: SetNull)

  @@unique([storeId, date])
}

// plan/fact накопичувальні за місяць, dayFact — продаж за день; null = значення не прочитано
model SalesMetric {
  id         String         @id @default(uuid())
  storeId    String
  date       DateTime       @db.Date
  metricCode String
  plan       Float?
  fact       Float?
  dayFact    Float?
  sourceId   String?
  syncId     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  store      Store          @relation(fields: [storeId], references: [id])
  metric     SalesMetricDef @relation(fields: [metricCode], references: [code])
  source     DataSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sync       SyncRun?       @relation(fields: [syncId], references: [id], onDelete: SetNull)

  @@unique([storeId, date, metricCode])
  @@index([date, metricCode])
}


// ───────── Навчання (етапи → уроки → тест) ─────────

// Етап програми навчання. Відкривається, коли попередній етап повністю пройдено.
model TrainingStage {
  id          String     @id @default(uuid())
  title       String
  description String     @default("")
  position    Int        @default(0)
  status      TestStatus @default(draft)
  testId      String?
  test        Test?      @relation(fields: [testId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lessons     TrainingLesson[]

  @@index([status, position])
}

// kind: text (BlockNote JSON у content) | video (посилання YouTube) | pdf (KnowledgeFile)
model TrainingLesson {
  id         String         @id @default(uuid())
  stageId    String
  stage      TrainingStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  position   Int            @default(0)
  kind       String
  title      String
  content    Json?
  videoUrl   String?
  fileId     String?
  file       KnowledgeFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  version    Int            @default(1)
  archivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  done       TrainingLessonDone[]
  versions   TrainingLessonVersion[]

  @@index([stageId, position])
}

model TrainingLessonVersion {
  id        String         @id @default(uuid())
  lessonId  String
  version   Int
  title     String
  content   Json?
  videoUrl  String?
  fileId    String?
  authorId  String
  createdAt DateTime       @default(now())
  lesson    TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, version])
}

model TrainingLessonDone {
  userId   String
  lessonId String
  doneAt   DateTime       @default(now())
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// Планові технічні роботи: плашка над шапкою показується до endsAt
model MaintenanceWindow {
  id          String   @id @default(uuid())
  startsAt    DateTime
  endsAt      DateTime
  message     String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  @@index([endsAt])
}
